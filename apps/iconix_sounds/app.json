{
  "id": "iconix_sounds",
  "title": "Iconix Sounds",
  "description": "Virtuelle Motor- und Elektro-Sounds abhängig von Drehzahl, Last und Geschwindigkeit, mit Profilen und Lautstärkeregelung. Ton über die Fahrzeuglautsprecher (Audiomanager + SmartX), Tonweg zum Testen wählbar. Braucht das Tool Iconix Audio.",
  "version": "0.9.5",
  "vendor": "custom",
  "loggingId": "ICXS",
  "iconGlyph": "engine",
  "mguHmi": ["ID7", "ID8"],
  "autostart": true,
  "requires": {
    "iconix-audiod": "0.9.5"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusActualValueTorque2": "s",
      "_optional": "Motormoment als Lastquelle (ohne: Gaspedal oder Drehzahlanstieg)"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "AngleAcceleratorPedal": "s",
      "_optional": "Gaspedal als Lastquelle (Skalierung unbestätigt)"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": [
        "connect",
        "disconnect",
        "getListMainConnections",
        "getListMainSources",
        "getListMainSinks"
      ],
      "_optional": "Ton auf den Fahrzeuglautsprechern (Audiomanager-Verbindung)"
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": [
        "hookSourceAvailablityStatusChange"
      ],
      "_optional": "CarLife-Quellen als verfügbar melden"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Iconix Sounds",
      "buttons": [
        ["BTN_PROFILE", "Sound wechseln"],
        ["BTN_MUTE", "Stumm / Ton an"],
        ["BTN_TEST", "Testsound"],
        ["BTN_DIAG", "Audio-Diagnose"],
        ["BTN_SETTINGS", "Einstellungen"]
      ]
    }
  ],
  "settings": [
